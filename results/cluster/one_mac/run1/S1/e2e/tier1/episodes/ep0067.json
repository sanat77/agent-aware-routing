 "final_summary": "The bug was caused by a query condition in tracker/repository.py that incorrectly included both owner_id and assignee_id in the filter, leading to tasks assigned to the user being counted. The fix modified the query to only filter by owner_id, ensuring that only tasks owned by the specified user are counted, which aligns with the expected behavior.",
 "diff": "diff --git a/tracker/repository.py b/tracker/repository.py\nindex f66451d..9698272 100644\n--- a/tracker/repository.py\n+++ b/tracker/repository.py\n@@ -119,9 +119,8 @@ class TaskRepository:\n         sql = \"SELECT status, COUNT(*) AS n FROM tasks\"\n         args = []\n         if owner_id is not None:\n-            sql += \" WHERE owner_id = ? OR assignee_id = ?\"\n-            args.extend([owner_id, owner_id])\n-        sql += \" GROUP BY status\"\n+            sql += \" WHERE owner_id = ?\"\n+            args.extend([owner_id])\n         with self.db.connection() as conn:\n             rows = conn.execute(sql, args).fetchall()\n         counts = {status: 0 for status in STATUSES}\n",
