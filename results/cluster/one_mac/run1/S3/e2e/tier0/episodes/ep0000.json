 "final_summary": "The bug was caused by a validation condition that rejected titles of exactly 120 characters due to using `>=` instead of `>`. The fix changed the condition to `len(title) > TITLE_MAX`, allowing titles of exactly 120 characters to pass. This ensures the maximum length is inclusive, as required by the specification.",
 "diff": "diff --git a/tracker/validation.py b/tracker/validation.py\nindex b7fea55..19dec12 100644\n--- a/tracker/validation.py\n+++ b/tracker/validation.py\n@@ -17,8 +17,6 @@ EMAIL_RE = re.compile(r\"^[^@\\s]+@[^@\\s]+\\.[a-zA-Z]{2,}$\")\n PASSWORD_MIN = 8\n \n TASK_FIELDS = {\"title\", \"description\", \"priority\", \"assignee_id\", \"due_at\", \"tags\", \"status\"}\n-\n-\n def _clean_title(value):\n     if value is None:\n         raise ValidationError(\"title is required\", {\"title\": \"required\"})\n@@ -27,11 +25,10 @@ def _clean_title(value):\n     title = value.strip()\n     if len(title) < TITLE_MIN:\n         raise ValidationError(\"title must not be empty\", {\"title\": \"empty\"})\n-    if len(title) >= TITLE_MAX:\n+    if len(title) > TITLE_MAX:\n         raise ValidationError(f\"title must be at most {TITLE_MAX} characters\", {\"title\": \"too_long\"})\n     return title\n \n-\n def _clean_description(value):\n     if value is None:\n         return None\n@@ -39,8 +36,6 @@ def _clean_description(value):\n         raise ValidationError(\"description must be a string\", {\"description\": \"invalid\"})\n     text = value.strip()\n     return text or None\n-\n-\n def _clean_priority(value):\n     priority = parse_int(value, name=\"priority\")\n     if priority is None:\n",
