 "diff": "diff --git a/tracker/retry.py b/tracker/retry.py\nindex e98e4fa..476354e 100644\n--- a/tracker/retry.py\n+++ b/tracker/retry.py\n@@ -12,19 +12,4 @@ def backoff_delays(attempts, base_delay, max_delay=2.0):\n     return [min(base_delay * (2 ** i), max_delay) for i in range(max(attempts - 1, 0))]\n \n \n-def retry_call(func, attempts=3, base_delay=0.05, sleep=time.sleep, retry_on=(TransientError,)):\n-    \"\"\"Call `func` up to `attempts` times, retrying only on `retry_on` exceptions.\n-\n-    Non-retryable exceptions propagate immediately. After the final failed attempt\n-    the last exception is re-raised.\n-    \"\"\"\n-    if attempts < 1:\n-        raise ValueError(\"attempts must be >= 1\")\n-    delays = backoff_delays(attempts, base_delay)\n-    for attempt in range(attempts - 1):\n-        try:\n-            return func()\n-        except retry_on:\n-            if attempt == attempts - 1:\n-                raise\n-            sleep(delays[attempt])\n+    def retry_call(func, attempts=3, base_delay=0.05, sleep=time.sleep, retry_on=(TransientError,)):\\n    \"\"\"Call `func` up to `attempts` times, retrying only on `retry_on` exceptions.\\n\\n    Non-retryable exceptions propagate immediately. After the final failed attempt\\n    the last exception is re-raised.\\n    \"\"\"\\n    if attempts < 1:\\n        raise ValueError(\"attempts must be >= 1\")\\n    delays = backoff_delays(attempts, base_delay)\\n    for attempt in range(attempts - 1):\\n        try:\\n            result = func()\\n            return result\\n        except retry_on:\\n            if attempt == attempts - 1:\\n                raise\\n            sleep(delays[attempt])\n",
